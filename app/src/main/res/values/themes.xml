<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.0.24：colorControlActivated 从 white 恢复为 @color/brand。
  原因：EditText 的光标 / 选区手柄 / 选区背景色取自 colorControlActivated，
  设为白色时光标在浅色输入框上不可见（用户实测反馈）。
  App Bar 上的 Switch 改为控件级 app:thumbTint / app:trackTint（白色选择器），
  不再依赖全局 colorControlActivated。
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.XiaoAiBrain" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorAccent">@color/brand</item>
        <!-- 恢复品牌色：EditText 光标/手柄/选区背景的可视性依赖它 -->
        <item name="colorControlActivated">@color/brand</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_sub</item>
        <item name="android:textColorHint">@color/text_faint</item>
    </style>

</resources>
